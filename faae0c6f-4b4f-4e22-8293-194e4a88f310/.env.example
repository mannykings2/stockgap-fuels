# ---------------------------------------------------------------------------
# Stockgap Platform - server environment
# Copy to `.env` in the project root: cp .env.example .env
# ---------------------------------------------------------------------------

# HTTP port for the REST API and (in production) the built frontend
PORT=4000

# Where the SQLite database file lives, relative to the server workspace.
# Use an absolute path in production. ":memory:" is used by the test suite.
DATABASE_FILE=./data/stockgap.db

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production-please-use-48-random-bytes

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "development" exposes password-reset tokens in the API response for the
# demo environment. NEVER use development in production.
NODE_ENV=

# Show the demo account switcher (16 roles, one shared password) on /login.
# Defaults to true when NODE_ENV is not "production".
# In a hosted environment set DEMO_ACCOUNTS=true while testing, then remove it.
# DEMO_ACCOUNTS=falsedevelopment
